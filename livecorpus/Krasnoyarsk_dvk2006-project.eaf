    <TIER ANNOTATOR="sova2007sova-hue" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" TIER_ID="comment">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a481"
                TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>если каждое слово отдельно смотреть, то это ADP и ADJ, но "в целом" вместе является ADV</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a458"
                TIME_SLOT_REF1="ts192" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>"плойка" же в переносном значении... Но мы воспринимаем каждое слово отдельно, в отрыве от других, поэтому ставлю NOUN</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a439"
                TIME_SLOT_REF1="ts202" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>"иии" либо CONJ, либо INTJ. Я склоняюс к первому, тк оно служит для связи предложений.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
